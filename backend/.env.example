# ---------------------------------------------------------------------------
# CHANGEABLE: copy this file to ".env" and fill in your own Supabase project's
# values. Never commit the real ".env" file — only this ".env.example".
# ---------------------------------------------------------------------------

# Get this from: Supabase Dashboard -> Project Settings -> Database ->
# "Connection string" -> URI (choose the "Session pooler" or direct
# connection string). It looks like:
# postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# CHANGEABLE: the exact origin your frontend is served from. Must match
# whatever local static server / port you use to open frontend/index.html.
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Optional real-LLM path for Section 3 (OFF by default — grading runs with
# this unset). Leave both blank/absent to use the free, keyless mock parser.
USE_REAL_LLM=false
XAI_API_KEY=you api key